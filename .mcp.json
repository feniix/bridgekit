{
  "mcpServers": {
    "sequential-thinking": {
      "command": "uvx",
      "args": [
        "--from",
        "sequential-thinking@0.7.0",
        "mcp-sequential-thinking"
      ]
    },
    "code-reasoning": {
      "command": "npx",
      "args": [
        "-y",
        "github:feniix/code-reasoning#fix-strict-stdio-startup"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@v1.5.1",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd"
      ]
    }
  }
}
